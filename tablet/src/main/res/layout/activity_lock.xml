<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- Empty-battery glyph, centered, shown briefly to mimic a dead device. -->
    <ImageView
        android:id="@+id/batteryGlyph"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_battery_empty"
        android:visibility="gone" />

    <!-- Opaque black layer that covers everything once the glyph fades. -->
    <View
        android:id="@+id/blackLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:alpha="1" />
</FrameLayout>
